# Copy to .env and edit. Never commit .env.

# Which model the chatbot uses: "ollama" (local, free) or "mock" (canned replies, used in CI)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Guardrails off = the vulnerable baseline. Turn on to measure the defended version.
GUARDRAILS_ENABLED=false

# true = the retriever can reach data/docs/internal/ (the baseline weakness).
# false = internal docs are never loaded, so the bot can't leak them.
RAG_INCLUDE_INTERNAL=true

# Input check with Llama Guard (needs GUARDRAILS_ENABLED=true). Leave empty to turn it off.
# The 1b model missed obvious attacks in testing, so use the 8b one.
INPUT_GUARD_MODEL=
